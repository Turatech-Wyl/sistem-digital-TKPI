# Dibaca agent (agent/) — salin ke .env bila perlu diubah
# Lokal default: DB web/prisma/dev.db, data di ../data
DB_PATH="../web/prisma/dev.db"
DATA_DIR="../data"
# Basis web untuk unduh PDF kwitansi (lampiran WA)
WEB_URL="http://localhost:3001"
# Samakan dengan AGENT_TOKEN di web/.env (untuk /api/kwitansi/:id?token=)
AGENT_TOKEN="isi-token-acak-32-karakter"
# Nomor untuk uji awal: npm run test-wa -- 62812xxxxxxx "halo tes"
WA_UJI=""
