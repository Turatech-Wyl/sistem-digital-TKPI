# Agent WA — salin ke agent/.env. Dimuat otomatis oleh `npm run start` (--env-file-if-exists).

# Database SQLite yang SAMA dengan DATABASE_URL di web/.env
# Lokal: ../web/prisma/dev.db · Server: /opt/tk/data/tk.db
DB_PATH="../web/prisma/dev.db"
# Folder data bersama (media, backup, logs, status/QR WA). Server: /opt/tk/data
DATA_DIR="../data"

# Alamat web untuk mengunduh PDF kwitansi (lampiran WA).
# Lokal `npm run dev` = http://localhost:3000 · Server (start.sh) = http://localhost:3001
WEB_URL="http://localhost:3001"
# Wajib sama dengan AGENT_TOKEN di web/.env. Buat dengan: openssl rand -hex 16
AGENT_TOKEN="ganti-token-acak-32-karakter"

# Nomor untuk uji awal: npm run test-wa -- 62812xxxxxxx "halo tes"
WA_UJI=""
