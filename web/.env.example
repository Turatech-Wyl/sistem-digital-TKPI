# Web — salin ke web/.env. Nilai SEKOLAH_/REKENING_/TARIF_/akun hanya dipakai saat seed;
# setelah itu semuanya dikelola dari halaman Pengaturan (PRD §13).

# --- Wajib ---
# Lokal: file:./dev.db (relatif ke prisma/) · Server: file:/opt/tk/data/tk.db
DATABASE_URL="file:./dev.db"
# Folder data bersama dengan agent. Lokal: kosongkan (default ../data) · Server: /opt/tk/data
DATA_DIR=""
# URL publik aplikasi (dipakai redirect logout). Server: https://tk.willieputra.dev
NEXT_PUBLIC_BASE="http://localhost:3000"
# Tanda tangan cookie sesi, min 32 karakter. Buat dengan: openssl rand -hex 32
SESSION_SECRET="ganti-di-server-min-32-karakter-placeholder"
# Token internal agent untuk /api/kwitansi/:id — sama dengan AGENT_TOKEN di agent/.env
AGENT_TOKEN="ganti-token-acak-32-karakter"

# --- Seed awal (placeholder PRD §13) ---
SEKOLAH_NAMA="TK Permata Indonesia"
SEKOLAH_ALAMAT="Jl. Placeholder No. 1"
SEKOLAH_TELEPON="62812xxxxxxx"
REKENING_BANK="BCA"
REKENING_NOMOR="0000000000"
REKENING_NAMA="TK Permata Indonesia"
WA_SEKOLAH="62812xxxxxxx"

TARIF_KB="300000"
TARIF_TKA="350000"
TARIF_TKB="350000"
JATUH_TEMPO_TGL="10"

ADMIN_EMAIL="admin@tk.local"
VIEWER_EMAIL="viewer@tk.local"
# Ganti sebelum seed di server; ubah juga password lewat halaman Akun setelah login
SEED_PASSWORD="tk-admin-123"

# API key Gemini/Groq TIDAK diisi di sini — isi di halaman Pengaturan (disimpan di DB).
